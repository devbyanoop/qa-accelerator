# Copy to .env.<TEST_ENV> (e.g. .env.local, .env.qa). Real environment variables take precedence.
UI_URL=http://localhost:4200
API_URL=http://localhost:8091

# Credentials: inject from your CI secret store or vault. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=

# Optional: cap parallel workers for a slow or shared environment.
# WORKERS=2

# Shown in report titles and labels.
APP_NAME=

# Optional: direct database access for the checks in tests/db (skipped when DB_HOST is not set).
# These match the containers started by `npm run app:start`.
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_USER=user
# DB_PASSWORD=root
# DB_NAME=toolshop
