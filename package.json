{
  "name": "qa-accelerator",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-ready Playwright + TypeScript end-to-end test automation framework",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "app:start": "node scripts/start-app.mjs",
    "app:stop": "node scripts/start-app.mjs --stop",
    "report": "playwright show-report",
    "report:allure:generate": "allure generate allure-results --clean",
    "report:allure:open": "allure open",
    "report:allure": "npm run report:allure:generate && npm run report:allure:open",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.0",
    "allure": "^3.22.1",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^16.4.5",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20"
  }
}
