{
  "name": "qa-accelerator",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript end-to-end test automation framework: UI and API tests, reporting and CI",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:capture": "node tools/clean-reports.mjs raw && playwright test --config=playwright.capture.config.ts",
    "app:start": "node tools/start-app.mjs",
    "app:stop": "node tools/start-app.mjs --stop",
    "report": "playwright show-report reports/standard/playwright",
    "report:allure:generate": "allure generate reports/_raw/allure-results --clean --config config/allurerc.mjs",
    "report:allure:open": "allure open reports/standard/allure",
    "report:allure": "npm run report:allure:generate && npm run report:allure:open",
    "report:validation": "node tools/evidence-bundle.mjs --pdf",
    "report:validation:open": "allure open reports/regulated/allure",
    "traceability": "node tools/traceability.mjs",
    "evidence": "node tools/evidence-bundle.mjs",
    "clean": "node tools/clean-reports.mjs",
    "regulated:status": "node tools/regulated-config.mjs",
    "regulated:run": "node tools/regulated-run.mjs",
    "regulated:compare": "node tools/regulated-compare.mjs",
    "regulated:verify": "node tools/regulated-verify.mjs",
    "regulated:note": "node tools/regulated-note.mjs",
    "test:tools": "node --test tools/",
    "docs:pdf": "node tools/docs-to-pdf.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.0",
    "allure": "^3.22.1",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "archiver": "^8.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.2",
    "lint-staged": "^17.6.0",
    "marked": "^12.0.2",
    "mysql2": "^3.24.6",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "yauzl": "^3.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 110,
    "trailingComma": "all"
  }
}
